{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "watch": "npm run development -- --watch",
        "watch-poll": "npm run watch -- --watch-poll",
        "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
        "prod": "npm run production",
        "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "build-wajadcorpoate": "cd nova-components/Wajadcorpoate && npm run dev",
        "build-wajadcorpoate-prod": "cd nova-components/Wajadcorpoate && npm run prod",
        "build-wajadcorporate": "cd nova-components/Wajadcorporate && npm run dev",
        "build-wajadcorporate-prod": "cd nova-components/Wajadcorporate && npm run prod",
        "build-custom-nexmo": "cd nova-components/CustomNexmo && npm run dev",
        "build-custom-nexmo-prod": "cd nova-components/CustomNexmo && npm run prod",
        "build-packages_and_products": "cd nova-components/PackagesAndProducts && npm run dev",
        "build-packages_and_products-prod": "cd nova-components/PackagesAndProducts && npm run prod"
    },
    "devDependencies": {
        "axios": "^0.19",
        "bootstrap": "^4.1.0",
        "cross-env": "^5.1",
        "jquery": "^3.2",
        "laravel-mix": "^4.0.7",
        "lodash": "^4.17.13",
        "popper.js": "^1.12",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.15.2",
        "sass-loader": "^7.1.0",
        "vue": "^2.5.17",
        "vue-template-compiler": "^2.6.10"
    }
}