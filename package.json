{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "build-sendsms": "cd nova-components/Sendsms && npm run dev",
        "build-sendsms-prod": "cd nova-components/Sendsms && npm run prod",
        "build-google-maps": "cd nova-components/GoogleMaps && npm run dev",
        "build-google-maps-prod": "cd nova-components/GoogleMaps && npm run prod",
        "build-analytics": "cd nova-components/tightenco/nova-google-analytics && npm run dev",
        "build-analytics-prod": "cd nova-components/tightenco/nova-google-analytics && npm run prod"
    },
    "devDependencies": {
        "axios": "^0.19",
        "bootstrap": "^4.1.0",
        "jquery": "^3.2",
        "laravel-mix": "^6.0.12",
        "lodash": "^4.17.13",
        "popper.js": "^1.12",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.15.2",
        "sass-loader": "^7.1.0",
        "vue": "^2.5.17",
        "vue-template-compiler": "^2.6.10",
        "postcss": "^8.2.8"
    },
    "dependencies": {
