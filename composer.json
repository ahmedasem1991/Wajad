{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.1.3",
        "anaseqal/nova-sidebar-icons": "^0.0.3",
        "barryvdh/laravel-dompdf": "^0.8.6",
        "beyondcode/laravel-websockets": "^1.3",
        "bissolli/nova-phone-field": "^0.0.4",
        "bolechen/nova-activitylog": "^0.1.4",
        "classic-o/nova-media-library": "^0.5.4",
        "comodolab/nova-help": "^0.4.0",
        "coreproc/nova-echo": "^0.2.0",
        "coreproc/nova-notification-feed": "^1.3",
        "crazybooot/base64-validation": "^1.0",
        "darkaonline/l5-swagger": "^8.0",
        "dillingham/nova-button": "^1.0",
        "dillingham/nova-errors": "^1.0",
        "edujugon/push-notification": "^4.1",
        "emilianotisato/nova-belongsto-depends": "^0.1.4",
        "epartment/nova-dependency-container": "^1.1",
        "facade/ignition": "^2.0",
        "fideloper/proxy": "^4.2",
        "genealabs/nova-map-marker-field": "^0.1.12",
        "guzzlehttp/guzzle": "^6.",
        "idf/laravel-real-email-validation": "^1.0",
        "intervention/image": "^2.5",
        "jfeid/nova-google-maps": "^1.1",
        "khalin/nova-link-field": "^1.1",
        "koss-shtukert/laravel-nova-select2-auto-complete": "^1.19",
        "laracasts/generators": "^2.0",
        "laravel/framework": "^7.0",
        "laravel/nova": "^3.10",
        "laravel/nexmo-notification-channel": "^2.2",
        "laravel/socialite": "^4.4",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.0",
        "liliom/laravel-unifonic": "^1.0",
        "maatwebsite/laravel-nova-excel": "^1.1",
        "manmohanjit/nova-belongs-to-dependency": "^1.1",
        "mjaschen/phpgeo": "^2.1",
        "mpociot/laravel-apidoc-generator": "^4.0",
        "naif/paypal": "^1.7",
        "naif/toggle": "^1.2",
        "nexmo/client": "^2.4",
        "niklasravnsborg/laravel-pdf": "^3.1",
        "optimistdigital/nova-multiselect-field": "^1.10",
        "optimistdigital/nova-sortable": "^1.4",
        "orlyapps/nova-belongsto-depend": "^2.0",
        "owenmelbz/nova-radio-field": "^0.0.5",
        "paypal/rest-api-sdk-php": "^1.14",
        "phpseclib/phpseclib": "~2.0",
        "pktharindu/nova-permissions": "^1.2",
        "predis/predis": "^1.1",
        "pusher/pusher-http-laravel": "^4.2",
        "silvanite/novafieldcheckboxes": "^1.2",
        "simplesoftwareio/simple-qrcode": "^2.0",
        "sloveniangooner/searchable-select": "^1.3",
        "smartappco/google-maps": "*",
        "socialiteproviders/apple": "^3.0",
        "socialiteproviders/instagram": "^3.0",
        "socialiteproviders/microsoft": "^3.0",
        "socialiteproviders/twitter": "^3.0",
        "spatie/laravel-permission": "^3.2",
        "spatie/laravel-query-builder": "^3.2",
        "srmklive/paypal": "^1.6",
        "stephenlake/nova-fixed-bars": "^1.1",
        "stichoza/google-translate-php": "^4.1",
        "techouse/intl-date-time": "^1.6",
        "tightenco/nova-google-analytics": "*",
        "tintnaingwin/email-checker": "^2.0",
        "titasgailius/search-relations": "^1.0",
        "tymon/jwt-auth": "1.0.*"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.5",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5",
        "symfony/thanks": "^1.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": ["laravel/dusk"]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Services/Helpers/helper.php",
            "app/Services/Helpers/fcm.php",
            "app/Services/Helpers/sms.php"

        ],
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan nova:publish"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        },

        {
            "type": "path",
            "url": "./nova-components/GoogleMaps"
        },
        {
            "type": "path",
            "url": "./nova-components/tightenco/nova-google-analytics"
        }
    ]
}
