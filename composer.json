{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.1.3",
        "anaseqal/nova-sidebar-icons": "^0.0.3",
        "beyondcode/laravel-websockets": "^1.3",
        "bolechen/nova-activitylog": "^0.1.4",
        "comodolab/nova-help": "^0.1.0",
        "coreproc/nova-echo": "^0.2.0",
        "coreproc/nova-notification-feed": "^1.3",
        "darkaonline/l5-swagger": "5.8.*",
        "depsimon/nova-stripe-checkout-field": "^1.0",
        "dillingham/nova-button": "^1.0",
        "edujugon/push-notification": "^4.1",
        "epartment/nova-dependency-container": "^1.1",
        "fideloper/proxy": "^4.0",
        "genealabs/nova-map-marker-field": "^0.1.12",
        "guzzlehttp/guzzle": "^6.4",
        "halimtuhu/array-images": "^1.1",
        "khalin/nova-link-field": "^1.1",
        "koss-shtukert/laravel-nova-select2-auto-complete": "^1.19",
        "kristories/nova-qrcode-field": "^0.0.1",
        "laravel/framework": "5.8.*",
        "laravel/nexmo-notification-channel": "^2.2",
        "laravel/nova": "*",
        "laravel/tinker": "^1.0",
        "maatwebsite/laravel-nova-excel": "^1.1",
        "manmohanjit/nova-belongs-to-dependency": "^1.1",
        "marianvlad/nova-env-card": "^1.0",
        "mjaschen/phpgeo": "^2.1",
        "mpociot/laravel-apidoc-generator": "^4.0",
        "naif/paypal": "^1.7",
        "naif/toggle": "^1.2",
        "nexmo/client": "^2.0",
        "nexmo/laravel": "^2.1",
        "orlyapps/nova-belongsto-depend": "^2.0",
        "owenmelbz/nova-radio-field": "^0.0.5",
        "paypal/rest-api-sdk-php": "^1.14",
        "pktharindu/nova-permissions": "^1.2",
        "predis/predis": "^1.1",
        "pusher/pusher-http-laravel": "^4.2",
        "simplesoftwareio/simple-qrcode": "^2.0",
        "smartappco/download-qrcode-image": "*",
        "smartappco/google-maps": "*",
        "smartappco/qrcode-generator": "*",
        "spatie/laravel-permission": "^3.2",
        "spatie/laravel-query-builder": "^1.17",
        "srmklive/paypal": "^1.6",
        "stephenlake/nova-fixed-bars": "^1.1",
        "tymon/jwt-auth": "1.0.*"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^7.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        },
        {
            "type": "path",
            "url": "./nova-components/QrcodeGenerator"
        },
        {
            "type": "path",
            "url": "./nova-components/DownloadQrcodeImage"
        },
        {
            "type": "path",
            "url": "./nova-components/GoogleMaps"
        },
        {
            "type": "path",
            "url": "./nova-components/Analytics"
        },
        {
            "type": "path",
            "url": "./nova-components/Analytics"
        }
    ]
}
