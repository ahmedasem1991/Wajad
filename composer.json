{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.1.3",
        "anaseqal/nova-sidebar-icons": "^0.0.2",
        "bolechen/nova-activitylog": "^0.1.4",
        "carlson/nova-link-field": "^1.0",
        "daniel-de-wit/nova-paperclip": "^0.1.0",
        "dillingham/nova-index-textarea": "^1.0",
        "ebess/advanced-nova-media-library": "^2.7",
        "epartment/nova-dependency-container": "^1.1",
        "fideloper/proxy": "^4.0",
        "halimtuhu/array-images": "^1.1",
        "itainathaniel/nova-nexmo": "^1.0",
        "khalin/nova-link-field": "^1.1",
        "kristories/nova-qrcode-field": "^0.0.1",
        "kristories/nova-qrcode-manager": "^1.0",
        "laravel/framework": "5.8.*",
        "laravel/nova": "*",
        "laravel/tinker": "^1.0",
        "maatwebsite/laravel-nova-excel": "^1.1",
        "marianvlad/nova-env-card": "^1.0",
        "mydnic/laravel-kustomer": "^1.3",
        "mydnic/nova-kustomer": "^1.2",
        "naif/map_address": "^1.4",
        "nexmo/laravel": "^1.1",
        "optimistdigital/nova-page-manager": "^1.9",
        "orlyapps/nova-belongsto-depend": "^2.0",
        "remipou/nova-page-manager": "^1.0",
        "simplesoftwareio/simple-qrcode": "^2.0",
        "smartappco/packages_and_products": "*",
        "spatie/laravel-medialibrary": "^7.0.0",
        "spatie/laravel-permission": "^2.37",
        "spatie/laravel-query-builder": "^1.17",
        "spatie/laravel-translatable": "^4.1",
        "spatie/nova-translatable": "^2.0",
        "themsaid/nova-cashier-manager": "^0.2.1",
        "tightenco/nova-stripe": "^0.2.2",
        "tymon/jwt-auth": "1.0.*",
        "vyuldashev/nova-permission": "^1.9"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^7.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorpoate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/Wajadcorporate"
        },
        {
            "type": "path",
            "url": "./nova-components/CustomNexmo"
        },
        {
            "type": "path",
            "url": "./nova-components/PackagesAndProducts"
        }
    ]
}
